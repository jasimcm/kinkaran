# Telegram: create a bot with @BotFather, paste the token and the bot's username (without @)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
BOT_USERNAME=EasyBillDemoBot

# Gemini (optional): free key from https://aistudio.google.com/apikey
# Leave empty to use the offline parser only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Shop details printed on the bill
SHOP_NAME=Sreeja Stores
SHOP_ADDRESS=Near Bus Stand, Kottayam, Kerala
SHOP_PHONE=+91 98470 00000
UPI_VPA=sreejastores@okaxis

# WhatsApp Cloud API (Meta, free test number). See README "WhatsApp bot".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The bot's phone number with country code, e.g. 15551234567 (used for the wa.me QR)
WHATSAPP_NUMBER=
# Any secret word; type the same word in the Meta dashboard webhook settings
WHATSAPP_VERIFY_TOKEN=easybill-verify
# Optional but recommended: App settings > Basic > App secret
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Printing on the Mac: empty = just save PDFs in backend/printed/,
# "preview" = open each bill in Preview, or a printer name from `lpstat -p`,
# or "remote" on a cloud server: bills are queued and the shop Mac's print helper prints them
PRINTER=preview
# PRINT_PAPER: "a4" = the receipt at native 80mm size centred on an A4 sheet (inkjet/laser,
# e.g. HP Smart Tank), sent with -o media=A4 and no scaling. "receipt" = the 80mm page as-is
# (thermal printer).
PRINT_PAPER=a4

# Who may use the bot as the shopkeeper: Telegram user ids, comma separated.
# Send /myid to the bot to see yours. Everyone else can only open their own bill.
SHOPKEEPER_IDS=

# Secret for using the API through the public tunnel (the mic page on the shop phone):
# open https://<tunnel>/?key=<ACCESS_KEY> once. Empty = the API works only on this Mac.
# Make one with: openssl rand -hex 16
ACCESS_KEY=

# WhatsApp Cloud API bot only: numbers (with 91) allowed to make bills, comma separated
WHATSAPP_SHOPKEEPERS=

# Public HTTPS address of this server, for the PDF link in "Send on WhatsApp" messages.
# Start a tunnel (cloudflared tunnel --url http://localhost:8000) and paste its https URL here.
PUBLIC_URL=

# Auto-send bills on WhatsApp from a linked spare number (whatsapp-sender/, see README).
# The bot waits this many seconds so the shopkeeper can check the number and cancel.
AUTO_SEND_SECONDS=10
WA_SENDER_URL=http://127.0.0.1:3001
# Ban safety: AUTO_SEND=off turns auto-send off (the bot then shows the "Send on WhatsApp" button).
# Limits on auto-sends from the linked number, and the minimum gap between two sends.
AUTO_SEND=on
WA_MAX_PER_HOUR=10
WA_MAX_PER_DAY=30
WA_MIN_GAP_SECONDS=20
