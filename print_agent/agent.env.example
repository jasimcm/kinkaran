# Copy to print_agent/agent.env (it is not committed) and fill in.
# The cloud server's HTTPS address
KINKARAN_URL=https://myshop.duckdns.org
# The same ACCESS_KEY as in the server's .env
ACCESS_KEY=
# The shop printer's name, from: lpstat -p
PRINTER=HP_Smart_Tank_510_series
# a4 = the 80mm receipt centred on A4 (inkjet/laser); receipt = 80mm thermal paper
PRINT_PAPER=a4
# How often to ask the server for new bills
POLL_SECONDS=3
